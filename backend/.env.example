# Server Configuration
PORT=5000

# Database Configuration
# Local development: mongodb://localhost:27017/mindsprint
# Production (MongoDB Atlas): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mindsprint
MONGO_URI=mongodb://localhost:27017/mindsprint

# Authentication Secret
# Make sure to change this to a long, secure random string in production
JWT_SECRET=mindsprint_super_secret_jwt_key_2026

# Google Web Client ID for OAuth token verification
GOOGLE_CLIENT_ID_WEB=

# Google Gemini API Key
GEMINI_API_KEY=
