# Frontend API Configuration
# For local emulator/simulator testing: http://localhost:5000/api
# For testing on a physical phone with Expo Go, use your local computer's IP address: http://192.168.X.X:5000/api
# For production/deployment: https://your-backend-service.onrender.com/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Google Authentication Configuration (For Expo Google Sign-In)
# Obtain these credentials from the Google Cloud Console (https://console.cloud.google.com)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your_google_client_id_web.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your_google_client_id_android.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your_google_client_id_ios.apps.googleusercontent.com
